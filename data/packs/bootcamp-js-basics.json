      "id": "js-var-01",
      "concept": "variable declaration",
      "prompt": "What is stored in age after this line runs?",
      "code": {
        "lang": "js",
        "lines": [
          "let age = 24;"
        ],
        "focusLine": 0
      },
      "answer": {
        "type": "mcq",
        "options": [
          "undefined",
          "24",
          "'24'",
          "0"
        ],
        "correctIndex": 1,
        "why": [
          "undefined is what a box holds when it gets no value, like let age; on its own. Here age is given 24.",
          "",
          "'24' with quotes is a string (text). 24 without quotes is a number.",
          "Nothing sets age to 0. The value on the right of = is what gets stored."
        ]
      },
      "reveal": [
        {
          "layer": "memory",
          "memory": [
            {
              "name": "age",
              "value": "",
              "scope": "global",
              "changed": true,
              "uninitialized": true
            }
          ],
          "say": "Before any line runs, the engine scans the code and makes a box called age. It isn't ready to use yet."
        },
        {
          "line": 0,
          "layer": "memory",
          "eval": [
            "24"
          ],
          "memory": [
            {
              "name": "age",
              "value": "24",
              "scope": "global",
              "changed": true
            }
          ],
          "say": "Line 1 runs: the engine works out the value 24 and stores it, so age holds 24. Now age can be used."
        }
      ]
    },
    {
      "id": "js-let-01",
      "concept": "variable reassignment",
      "prompt": "What does this print?",
      "code": {
        "lang": "js",
        "lines": [
          "let x = 2;",
          "x = x * 3;",
          "console.log(x);"
        ],
        "focusLine": 1
      },
      "answer": {
        "type": "mcq",
        "options": [
          "2",
          "6",
          "23",
          "undefined"
        ],
        "correctIndex": 1,
        "why": [
          "2 was the first value, but line 2 replaces it with x * 3.",
          "",
          "* means multiply, not join. x * 3 is 2 × 3 = 6, not \"2\" followed by \"3\".",
          "x has a value by the time it is printed, so it isn't undefined."
        ]
      },
      "reveal": [
        {
          "layer": "memory",
          "memory": [
            {
              "name": "x",
              "value": "",
              "scope": "global",
              "changed": true,
              "uninitialized": true
            }
          ],
          "say": "Before running, the engine makes a box called x. It isn't ready yet."
        },
        {
          "line": 0,
          "layer": "memory",
          "eval": [
            "2"
          ],
          "memory": [
            {
              "name": "x",
              "value": "2",
              "scope": "global",
              "changed": true
            }
          ],
          "say": "Line 1: x is created with the value 2."
        },
        {
          "line": 1,
          "layer": "runtime",
          "eval": [
            "x * 3",
            "2 * 3",
            "6"
          ],
          "memory": [
            {
              "name": "x",
              "value": "6",
              "scope": "global",
              "changed": true
            }
          ],
          "say": "Line 2: the engine reads x (2), multiplies by 3, and writes 6 back into the same box."
        },
        {
          "line": 2,
          "layer": "output",
          "eval": [
            "x",
            "6"
          ],
          "output": "6",
          "memory": [
            {
              "name": "x",
              "value": "6",
              "scope": "global"
            }
          ],
          "say": "Line 3: console.log reads x and prints 6."
        }

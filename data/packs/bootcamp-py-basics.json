      "id": "py-var-01",
      "concept": "reassignment",
      "prompt": "What does this print?",
      "code": {
        "lang": "py",
        "lines": [
          "x = 7",
          "x = x + 3",
          "print(x)"
        ],
        "focusLine": 1
      },
      "answer": {
        "type": "mcq",
        "options": [
          "7",
          "10",
          "73",
          "x + 3"
        ],
        "correctIndex": 1,
        "why": [
          "7 was the first value. Line 2 replaces it.",
          "",
          "x is a number, so + adds. It would only join if x were text, like \"7\".",
          "print shows the value of x, not the code that made it."
        ]
      },
      "reveal": [
        {
          "layer": "code",
          "say": "Python reads the whole program first. Unlike JavaScript, no boxes exist yet: a name is made when it is first assigned."
        },
        {
          "line": 0,
          "layer": "memory",
          "eval": [
            "7"
          ],
          "memory": [
            {
              "name": "x",
              "value": "7",
              "scope": "global",
              "changed": true
            }
          ],
          "say": "Line 1: Python makes the name x and stores 7 in it."
        },
        {
          "line": 1,
          "layer": "runtime",
          "eval": [
            "x + 3",
            "7 + 3",
            "10"
          ],
          "memory": [
            {
              "name": "x",
              "value": "10",
              "scope": "global",
              "changed": true
            }
          ],
          "say": "Line 2: it works out x + 3, which is 7 + 3, and stores 10 back in x."
        },
        {
          "line": 2,
          "layer": "output",
          "eval": [
            "x",
            "10"
          ],
          "output": "10",
          "memory": [
            {
              "name": "x",
              "value": "10",
              "scope": "global"
            }
          ],
          "say": "Line 3: print shows 10."
        }
      ]
    },
